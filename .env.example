# Cloudflare R2
R2_ACCOUNT_ID=你的Cloudflare账户ID
R2_ACCESS_KEY_ID=你的R2 Access Key ID
R2_SECRET_ACCESS_KEY=你的R2 Secret Access Key
R2_BUCKET=你的R2 Bucket名称
# 可选：填写后优先使用此地址
# R2_ENDPOINT=https://你的账户ID.r2.cloudflarestorage.com

# 本机原生 Chrome 路径
# CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# 可选：浏览器开发者工具复制的完整同花顺 Cookie，用于新闻和公告接口
# THS_COOKIE=粘贴完整Cookie字符串，不要加引号
